{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-finder",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHEF_LIMITER",
        "class_name": "ChefDailyLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChefDailyLimiter"
      ]
    }
  ]
}
